# Ports uses the same wallpaper and native launch preparation as the other shelves.
phase SetClock
press a
phase Shelf
press l1
snap ports-grid
press a
snap ports-shelf
press left
snap ports-manager
press right
press right
snap ports-no-cover
press left
press a
wait 1000
snap balatro-missing-data
press b
press x
snap ports-search
