# Read-only setup report, including paging, Dreamcast's new row, details and recheck.
press a
phase Shelf
press menu
phase QuickMenu
press up
press a
press up
press a
phase SystemSetup
snap setup-list
press r1
grab setup-list-middle
press r1
grab setup-list-last
press down
press down
press down  # Dreamcast adds a system before PICO-8.
press a
snap setup-pico8
press down
snap setup-pico8-next
press x
snap setup-pico8-recheck
press b
press l1
press up
press up
press up     # Dreamcast shifts Sega CD one slot.
press a
snap setup-segacd
press down
snap setup-segacd-next
press b
press menu
phase QuickMenu
snap setup-parent
