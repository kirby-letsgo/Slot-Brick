# The quick menu and its pages open from the shelf, and B backs out.
press a
phase Shelf
press a      # Open the selected system from the startup grid.
press menu
phase QuickMenu
snap menu
press a
snap menu-screen
# Screen holds a page per system, each with that system's own settings.
press a
snap menu-screen-gb
press b
press down
press a
snap menu-screen-gba
press b
press down
press a
snap menu-screen-nes
press b
press down
press a
snap menu-screen-snes
press b
press down
snap menu-screen-on-md
press a
snap menu-screen-md
press b
press down    # Game Gear
press down    # Master System
press down    # Nintendo 64
press a
snap menu-screen-n64
press b
press down    # Neo Geo Pocket / Color
press a
snap menu-screen-ngp
press b
press down    # Sega 32X
snap menu-screen-scrolled
press a
snap menu-screen-32x
press b
press down    # Sega CD
press a
snap menu-screen-segacd
press b
press down    # PC Engine
press a
snap menu-screen-pce
press b
press down    # PC Engine CD
press a
snap menu-screen-pcecd
press b
press down    # PlayStation, end of the scrolling system list
snap menu-screen-end
press up
press up
press up
press up
press up      # Return to Neo Geo Pocket before backing out
press b
press down
press a
snap menu-gameplay
press b
press up
press up      # System: LEDs, Date & Time and About
press a
snap menu-system
press down
press a
snap menu-date-time
press b
press b
press b
phase Shelf
