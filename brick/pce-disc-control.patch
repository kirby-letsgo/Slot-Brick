+   if (!slot_disc_ejected || index > CDInterfaces.n) return false;
+   slot_disc_index = index;
+   return true;
+}
+static bool slot_replace_disc(unsigned index, const struct retro_game_info *info)
+{
+   (void)index; (void)info;
+   return false;
+}
+static bool slot_add_disc(void) { return false; }
+static struct retro_disk_control_callback slot_disk_control = {
